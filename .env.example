# Copy to .env.local for local development. Never commit real secrets.

# Supabase project "lgndry-co-ops". URL and anon key are public by design
# (row-level security is what protects the data), hence NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Server only. Never expose to the browser and never prefix with NEXT_PUBLIC_.
# Not required until server-side jobs/workflows land (mailbox sync, etc.).
SUPABASE_SERVICE_ROLE_KEY=
