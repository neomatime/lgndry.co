# Copy to .env.local for local development. Never commit real secrets.

# Supabase project "lgndry-co-ops". URL and anon key are public by design
# (row-level security is what protects the data), hence NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Required by the signed Start a Project upload pipeline. Server only.
# Never expose these values to the browser or prefix them with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ENQUIRY_UPLOAD_RATE_LIMIT_SECRET=
